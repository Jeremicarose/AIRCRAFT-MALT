# CKB Blockchain Configuration (Nervos Network)
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev/rpc
CKB_INDEXER_URL=https://testnet.ckb.dev/indexer
RECEIVER_REGISTRY_TYPE_HASH=0x1efe03c91687a43e8f8fc24d2fbb911e7071761ec4eaba06281cb52d8b505b6c
CKB_SSL_VERIFY=true
CKB_MAX_RECORD_AGE_SECONDS=86400
CKB_HYBRID_SIMULATION_MIN_RECEIVERS=4

# Production guardrail: set to true only for production-intended live deployments.
# When enabled, startup fails closed unless live ingest is explicitly configured.
STRICT_PRODUCTION_MODE=false

# Demo/replay fallback only. Must be false when STRICT_PRODUCTION_MODE=true.
SIMULATE_IF_UNAVAILABLE=true

# 4DSky Configuration
FOURDSKYAPIKEY=
FOURDSKYENDPOINT=
# Live example: command-jsonl or websocket-json. Demo-only example: simulation.
FOURDSKY_TRANSPORT=command-jsonl
FOURDSKY_AUTH_HEADER=X-API-Key
FOURDSKY_AUTH_SCHEME=
FOURDSKY_AUTH_TOKEN=
FOURDSKY_SUBSCRIBE_MESSAGE=
FOURDSKY_BRIDGE_COMMAND=python3 scripts/bridge_adapter.py --source stdin
# Set true only when the bridge reads a verified remote receiver source that
# the local hardware/port readiness probe cannot detect.
FOURDSKY_EXTERNAL_SOURCE_ATTESTED=false
# This launch attestation is only a static guardrail. Every observation must
# still carry runtime-verifiable clock metadata or the solver rejects it.
FOURDSKY_SYNCHRONIZED_CLOCKS_ATTESTED=false

# Runtime Configuration
MAX_RECEIVERS=10
LOG_LEVEL=INFO
DATABASE_PATH=data/mlat_data.db
BENCHMARK_REPORT_PATH=benchmark/latest.json
PERFORMANCE_REPORT_PATH=benchmark/performance-latest.json
RELIABILITY_REPORT_PATH=benchmark/reliability-latest.json
BENCHMARK_MARKDOWN_PATH=benchmark/BENCHMARKS.md
SIMULATION_RETENTION_HOURS=24
STATISTICS_RETENTION_DAYS=7
HEALTH_STALE_SIGNAL_SECONDS=120
STATS_INTERVAL_SECONDS=60
REQUIRE_LIVE_BENCHMARKABLE_OUTPUT=false
# Maximum declared one-way receiver clock uncertainty accepted by the solver.
MAX_CLOCK_UNCERTAINTY_NS=100

# Hosted Demo Configuration (demo/replay only; incompatible with STRICT_PRODUCTION_MODE=true)
DEMO_MODE=false
DEMO_SCENARIO=default
DEMO_READ_ONLY=true
DEMO_LABEL=Hosted demo · Northeast replay
DEMO_AUTO_CONNECT=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
ENABLE_ADMIN_API=false
ENABLE_BACKGROUND_BROADCASTER=true
API_KEY=
ADMIN_API_KEY=

# Next.js Frontend Configuration
NEXT_FRONTEND_DIR=frontend
NEXT_FRONTEND_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5057
