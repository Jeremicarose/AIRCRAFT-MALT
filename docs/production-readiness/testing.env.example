# Local controlled testing only. No live feeds or wallet configuration.
MLAT_ENV_FILE=/dev/null
CKB_NETWORK=testnet
CKB_RPC_URL=
CKB_INDEXER_URL=
RECEIVER_REGISTRY_TYPE_HASH=
RECEIVER_REGISTRY_HASH_TYPE=data1
CKB_SSL_VERIFY=true
FOURDSKY_TRANSPORT=simulation
FOURDSKY_ENDPOINT=
FOURDSKY_ALLOWED_ENDPOINTS=
FOURDSKY_API_KEY=
FOURDSKY_AUTH_TOKEN=
FOURDSKY_BRIDGE_COMMAND=
SIMULATE_IF_UNAVAILABLE=false
STRICT_PRODUCTION_MODE=false
DEMO_MODE=true
DEMO_READ_ONLY=true
DATABASE_PATH=data/controlled-synthetic.db
API_HOST=127.0.0.1
API_PORT=5057
API_DEBUG=false
ENABLE_ADMIN_API=false
ENABLE_BACKGROUND_BROADCASTER=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MLAT_API_INTERNAL_URL=http://127.0.0.1:5057
NEXT_PUBLIC_API_BASE_URL=
